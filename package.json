{
  "name": "ai-governance-interoperability-atlas",
  "private": false,
  "version": "1.2.0",
  "description": "Use-case-anchored atlas mapping shared operational controls, jurisdictional deltas, and regulatory friction across global AI governance instruments.",
  "license": "MIT AND CC-BY-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lihui-aigov/interoperability-atlas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/inject-seo-and-sitemap.mjs",
    "build:standalone": "vite build && node scripts/bundle-standalone.mjs && node scripts/inject-seo-and-sitemap.mjs",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-standalone server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test scripts/curate-atlas.test.mjs src/utils/atlasAnalytics.test.ts",
    "curate": "node scripts/curate-atlas.mjs",
    "curate:dry": "node scripts/curate-atlas.mjs --dry-run"
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
